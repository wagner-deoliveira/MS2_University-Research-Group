---
import Eyebrow from '@/components/Eyebrow.astro';
import ParticleField from '@/components/ParticleField.astro';

interface Props {
	eyebrow: string;
	title: string;
	highlight?: string;
	subtitle?: string;
	image?: string;
	/** Replace the banner image with the particle animation; the value sets the field angle in degrees. */
	animation?: number;
	animationLabel?: string;
	stats?: { value: string; label: string }[];
}

const { eyebrow, title, highlight, subtitle, image, animation, animationLabel, stats } = Astro.props;
const src = image?.split('/').map((p, i, a) => (i === a.length - 1 ? encodeURIComponent(p) : p)).join('/');
---

<section class="relative overflow-hidden bg-background">
	<div class="container mx-auto px-4 pt-16 pb-14 md:pt-24">
		<div class="grid items-end gap-10 lg:grid-cols-12">
			<div class="lg:col-span-7 lg:col-start-2">
				<Eyebrow class="text-muted-foreground">{eyebrow}</Eyebrow>
				<h1 class="mt-8 text-5xl font-medium leading-[0.98] md:text-7xl">
					{title}{highlight && <> <span class="text-brand-600 dark:text-mint-400">{highlight}</span></>}
				</h1>
			</div>
			{subtitle && (
				<div class="lg:col-span-3">
					<p class="text-lg leading-relaxed text-muted-foreground">{subtitle}</p>
				</div>
			)}
		</div>
		<slot />
	</div>

	<div class="container mx-auto px-4">
		{animation !== undefined ? (
			<ParticleField angle={animation} label={animationLabel} class="aspect-[16/9] rounded-[2rem] md:aspect-[21/8]" />
		) : src && (
			<div class="relative aspect-[16/9] overflow-hidden rounded-[2rem] md:aspect-[21/8]">
				<img src={src} alt="" class="slow-zoom h-full w-full object-cover" />
				<div class="absolute inset-0 bg-gradient-to-t from-ink-950/50 via-transparent to-transparent"></div>
			</div>
		)}
	</div>

	{stats && stats.length > 0 && (
		<div class="container mx-auto px-4">
			<dl class={`grid grid-cols-2 border-b border-border ${stats.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-4'}`}>
				{stats.map((s) => (
					<div class="border-border px-2 py-10 md:border-r md:px-8 md:last:border-r-0">
						<dt class="eyebrow text-muted-foreground">{s.label}</dt>
						<dd class="mt-3 font-display text-5xl font-medium tracking-tight md:text-6xl">{s.value}</dd>
					</div>
				))}
			</dl>
		</div>
	)}
</section>
