---
interface Props {
	eyebrow: string;
	title: string;
	highlight?: string;
	subtitle?: string;
	image: string;
	stats?: { value: string; label: string }[];
}

const { eyebrow, title, highlight, subtitle, image, stats } = Astro.props;
const src = image.split('/').map((p, i, a) => (i === a.length - 1 ? encodeURIComponent(p) : p)).join('/');
---

<section class="relative isolate overflow-hidden bg-slate-950 text-white">
	<img src={src} alt="" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-40" />
	<div class="absolute inset-0 -z-10 bg-gradient-to-br from-slate-950 via-slate-950/85 to-indigo-950/70"></div>
	<div class="absolute -right-32 -top-32 -z-10 h-[28rem] w-[28rem] rounded-full bg-indigo-500/25 blur-3xl"></div>
	<div class="absolute -bottom-40 left-1/4 -z-10 h-[24rem] w-[24rem] rounded-full bg-cyan-400/15 blur-3xl"></div>

	<div class="container mx-auto px-4 py-20 md:py-28">
		<span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-medium uppercase tracking-[0.2em] text-cyan-200 backdrop-blur">
			<span class="h-1.5 w-1.5 rounded-full bg-cyan-300 animate-pulse"></span>
			{eyebrow}
		</span>
		<h1 class="mt-6 max-w-4xl text-4xl font-bold leading-[1.05] tracking-tight md:text-6xl">
			{title}{highlight && <> <span class="bg-gradient-to-r from-cyan-300 via-sky-300 to-indigo-300 bg-clip-text text-transparent">{highlight}</span></>}
		</h1>
		{subtitle && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300 md:text-xl">{subtitle}</p>}
		<slot />
	</div>

	{stats && stats.length > 0 && (
		<div class="border-t border-white/10 bg-white/[0.03] backdrop-blur">
			<dl class={`container mx-auto grid grid-cols-2 px-4 ${stats.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-4'}`}>
				{stats.map((s) => (
					<div class="px-4 py-7 text-center">
						<dt class="sr-only">{s.label}</dt>
						<dd class="text-3xl font-bold text-white md:text-4xl">{s.value}</dd>
						<dd class="mt-1 text-sm text-slate-400">{s.label}</dd>
					</div>
				))}
			</dl>
		</div>
	)}
</section>
