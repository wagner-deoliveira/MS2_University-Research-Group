---
import { ModeToggle } from './ModeToggle';
import { MobileNav } from './MobileNav';
import { Image } from 'astro:assets';
import groupLogo from '@/assets/images/logo/LOGOMSMGroup_cropped.png';

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'People', href: '/people' },
  { name: 'Projects', href: '/projects' },
  { name: 'Publications', href: '/publications' },
  { name: 'Press', href: '/press' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur-xl">
  <div class="container mx-auto grid h-20 grid-cols-[1fr_auto_1fr] items-center gap-4 px-4">
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {navItems.map((item) => {
        const active = item.href === path;
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class={`rounded-full px-3 py-1.5 text-sm font-medium transition-colors ${active ? 'bg-mint-200 text-ink-950' : 'text-muted-foreground hover:bg-muted hover:text-foreground'}`}
          >
            {item.name}
          </a>
        );
      })}
    </nav>
    <div class="lg:hidden">
      <MobileNav client:load items={navItems} />
    </div>

    <a href="/" class="flex items-center justify-center" aria-label="Magnetic Soft Matter Group – Home">
      <Image src={groupLogo} alt="Magnetic Soft Matter Group" width={128} height={129} widths={[64, 128, 256]} sizes="44px" decoding="async" class="h-11 w-auto dark:invert" />
    </a>

    <div class="flex items-center justify-end gap-3">
      <a href="mailto:f2n2lab@go.ugr.es" class="hidden items-center gap-2 rounded-full bg-mint-200 px-4 py-2 text-sm font-medium text-ink-950 transition-colors hover:bg-mint-400 md:inline-flex">
        <span class="h-2 w-2 rounded-full bg-brand-600"></span>
        Contact us
      </a>
      <ModeToggle client:visible />
    </div>
  </div>
</header>
