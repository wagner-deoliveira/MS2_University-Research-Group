---
import { ModeToggle } from './ModeToggle';
import { MobileNav } from './MobileNav';

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'People', href: '/people' },
  { name: 'Projects', href: '/projects' },
  { name: 'Publications', href: '/publications' },
];
---

<header class="border-b bg-background/95 backdrop-blur supports-backdrop-filter:bg-background/60 sticky top-0 z-50">
  <div class="container mx-auto px-4 py-3 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <a href="/" class="flex items-center">
        <img src="/assets/images/logo/LOGOMSMGroup_cropped.png" alt="logo" class="h-12 w-auto dark:invert" />
      </a>
    </div>

    <div class="flex items-center space-x-4">
      <nav class="hidden md:flex space-x-6">
        {navItems.map((item) => (
          <a href={item.href} class="text-muted-foreground hover:text-foreground transition-colors font-medium">
            {item.name}
          </a>
        ))}
      </nav>

      <MobileNav client:visible items={navItems} />

      <div class="border-l pl-4 flex items-center space-x-2">
        <ModeToggle client:visible />
      </div>
    </div>
  </div>
</header>
