---
export interface PressItem {
	title: string;
	date?: string;
	outlet?: string;
	href?: string;
}

interface Props {
	class?: string;
	items: PressItem[];
}

const { class: className = '', items } = Astro.props;

const feed: PressItem[] = items.length > 0 ? items : [{ title: 'No press coverage yet', outlet: 'UGR' }];
---

<div class:list={['press-wire relative overflow-hidden', className]}>
	<!-- vertical rail the headlines travel along -->
	<div class="wire-rail absolute inset-y-0 left-10 w-px" aria-hidden="true"></div>

	<!-- scrims so the badge and caption stay legible over the feed -->
	<div class="wire-scrim wire-scrim-top pointer-events-none absolute inset-x-0 top-0 h-44" aria-hidden="true"></div>
	<div class="wire-scrim wire-scrim-bottom pointer-events-none absolute inset-x-0 bottom-0 h-32" aria-hidden="true"></div>

	<!-- read head: the line the wire is being read at -->
	<div class="wire-head absolute inset-x-0 top-1/2" data-head aria-hidden="true">
		<span class="wire-head-glow absolute inset-x-0 top-1/2 h-32 -translate-y-1/2"></span>
		<span class="wire-head-line absolute inset-x-0 top-1/2 h-px -translate-y-1/2"></span>
		<span class="wire-head-dot absolute left-10 top-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full"></span>
	</div>

	<!-- the feed itself -->
	<div class="wire-window absolute inset-0 overflow-hidden" data-window>
		<div class="wire-track absolute inset-x-0 top-0" data-track>
			{[0, 1].map((copy) => (
				<div class="wire-cycle" data-cycle aria-hidden={copy === 1 ? 'true' : undefined}>
					{feed.map((item) => (
						<div
							class="wire-item"
							data-item
						>
							<span class="wire-meta">
								<span class="wire-outlet">{item.outlet ?? 'UGR'}</span>
								{item.date && <span class="wire-date">{item.date}</span>}
							</span>
							<span class="wire-headline">
								{item.href ? (
									<a href={item.href} target="_blank" rel="noopener">{item.title}</a>
								) : (
									item.title
								)}
							</span>
						</div>
					))}
				</div>
			))}
		</div>
	</div>

	<!-- header badge -->
	<div class="pointer-events-none absolute left-5 top-5 flex items-center gap-2 rounded-full border bg-background/70 px-3.5 py-1.5 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-muted-foreground backdrop-blur">
		<span class="h-1.5 w-1.5 animate-pulse rounded-full bg-coral-400"></span>
		<span data-wire-count>{feed.length} headlines</span>
	</div>
</div>

<style>
	.press-wire {
		container-type: size;
		background:
			radial-gradient(120% 70% at 50% 50%, rgb(160 213 203 / 0.12), transparent 70%),
			linear-gradient(to bottom, rgb(160 213 203 / 0.05), transparent 40%, rgb(248 116 104 / 0.05));
	}

	/* dashed vertical rail */
	.wire-rail {
		background-image: linear-gradient(to bottom, var(--color-mint-400) 50%, transparent 50%);
		background-size: 1px 9px;
		opacity: 0.35;
	}

	/* scrims: fade the feed into the panel edges so the overlays read cleanly */
	.wire-scrim-top {
		background: linear-gradient(to bottom, var(--background) 60%, transparent);
	}
	.wire-scrim-bottom {
		background: linear-gradient(to top, var(--background) 45%, transparent);
	}

	/* read head */
	.wire-head-line {
		background-image: linear-gradient(to right, var(--color-mint-400) 50%, transparent 50%);
		background-size: 7px 1px;
		opacity: 0.45;
	}
	.wire-head-glow {
		background: linear-gradient(to bottom, transparent, rgb(160 213 203 / 0.1), transparent);
	}
	.wire-head-dot {
		background: var(--color-coral-400);
		box-shadow: 0 0 0 4px rgb(248 116 104 / 0.18);
	}

	/* feed window fades in and out at both ends */
	.wire-window {
		-webkit-mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent);
		mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent);
	}
	.wire-track {
		will-change: transform;
	}

	.wire-item {
		padding: 1.35rem 2.5rem 1.35rem 4.5rem;
		opacity: 0.32;
		transform: translateX(0);
		transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.wire-item.is-current {
		opacity: 1;
		transform: translateX(8px);
	}

	.wire-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.62rem;
		text-transform: uppercase;
		letter-spacing: 0.18em;
	}
	.wire-outlet {
		color: var(--color-brand-600);
		transition: color 0.4s ease;
	}
	:global(.dark) .wire-outlet {
		color: var(--color-mint-400);
	}
	.wire-date {
		color: var(--muted-foreground);
	}
	.wire-item.is-current .wire-outlet {
		color: var(--color-coral-400);
	}

	.wire-headline {
		display: block;
		margin-top: 0.6rem;
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 2.2cqw, 1.4rem);
		line-height: 1.24;
		letter-spacing: -0.02em;
		color: var(--foreground);
	}
	.wire-headline a {
		text-decoration: none;
		background-image: linear-gradient(var(--color-coral-400), var(--color-coral-400));
		background-size: 0% 1px;
		background-repeat: no-repeat;
		background-position: 0 100%;
		transition: background-size 0.35s ease;
	}
	.wire-headline a:hover {
		background-size: 100% 1px;
	}

	@media (prefers-reduced-motion: reduce) {
		.wire-item {
			transition: none;
		}
	}
</style>

<script>
	function init(root: HTMLElement) {
		const track = root.querySelector<HTMLElement>('[data-track]');
		const feed = root.querySelector<HTMLElement>('[data-window]');
		const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];
		if (!track || !feed || items.length === 0) return;

		const SPEED = 26; // px per second
		const HEAD = 0.5; // read head position, as a fraction of the panel height

		// the headline text is what the eye tracks, so the head is matched against it
		const heads = items.map((el) => el.querySelector<HTMLElement>('.wire-headline') ?? el);

		let cycleH = 0;
		let y = 0;
		let current = -1;
		let paused = false;

		const measure = () => {
			const cycle = track.querySelector<HTMLElement>('[data-cycle]');
			cycleH = cycle?.offsetHeight ?? 0;
			if (cycleH > 0) y %= cycleH;
		};

		const setCurrent = (idx: number) => {
			if (idx === current) return;
			current = idx;
			items.forEach((el, i) => el.classList.toggle('is-current', i === idx));
		};

		// highlight whichever headline sits closest to the read head
		const update = () => {
			const rootRect = root.getBoundingClientRect();
			const headY = rootRect.height * HEAD;
			let best = -1;
			let bestD = Infinity;
			for (let i = 0; i < heads.length; i++) {
				const r = heads[i].getBoundingClientRect();
				const center = r.top - rootRect.top + r.height / 2;
				if (center < 0 || center > rootRect.height) continue; // outside the visible window
				const d = Math.abs(center - headY);
				if (d < bestD) {
					bestD = d;
					best = i;
				}
			}
			if (best >= 0) setCurrent(best);
		};

		const place = (offset: number) => {
			track.style.transform = `translate3d(0, ${-offset}px, 0)`;
			update();
		};

		measure();
		new ResizeObserver(measure).observe(track);

		// hovering a headline (or tabbing into one) holds the wire still
		feed.addEventListener('mouseenter', () => (paused = true));
		feed.addEventListener('mouseleave', () => (paused = false));
		feed.addEventListener('focusin', () => (paused = true));
		feed.addEventListener('focusout', () => (paused = false));

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			// static frame: first headline parked on the read head
			const first = heads[0].getBoundingClientRect();
			const rootRect = root.getBoundingClientRect();
			place(first.top - rootRect.top + first.height / 2 - rootRect.height * HEAD);
			return;
		}

		let visible = true;
		new IntersectionObserver((entries) => {
			visible = entries[0]?.isIntersecting ?? true;
		}).observe(root);

		let last = performance.now();
		const loop = (now: number) => {
			const dt = Math.min(1 / 20, (now - last) / 1000);
			last = now;
			if (visible && !document.hidden && !paused && cycleH > 0) {
				y = (y + SPEED * dt) % cycleH;
				place(y);
			}
			requestAnimationFrame(loop);
		};
		requestAnimationFrame(loop);
	}

	document.querySelectorAll<HTMLElement>('.press-wire').forEach(init);
</script>
