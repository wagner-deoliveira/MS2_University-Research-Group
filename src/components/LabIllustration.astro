---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

// Test tubes: position, tilt, length and liquid level (local coords, origin at the rim centre)
const tubes = [
	{ id: 't1', x: 160, y: 12, rot: -28, h: 150, level: 70, delay: 0 },
	{ id: 't2', x: 270, y: 468, rot: 0, h: 150, level: 60, delay: -1.6 },
	{ id: 't3', x: 548, y: 470, rot: 0, h: 150, level: 48, delay: -3.1 },
];
const tubeBody = (h: number) => `M-18,0 V${h - 18} A18,18 0 0 0 18,${h - 18} V0`;
const tubeInner = (h: number) => `M-15,0 V${h - 18} A15,15 0 0 0 15,${h - 18} V0 Z`;
// A wave of period 40 that can slide 40px to the right and still cover the vessel
const wave = (level: number, depth: number, from = -80, to = 120) => {
	let d = `M${from},${level}`;
	for (let x = from; x < to; x += 40) d += ` Q${x + 10},${level - 5} ${x + 20},${level} T${x + 40},${level}`;
	return `${d} V${depth} H${from} Z`;
};

// DNA double helix sampled as two phase-shifted sine strands plus base-pair rungs
const helix = (phase: number) => {
	const pts: string[] = [];
	for (let x = -170; x <= 170; x += 4) pts.push(`${x},${(22 * Math.sin((x / 80) * 2 * Math.PI + phase)).toFixed(2)}`);
	return `M${pts.join(' L')}`;
};
const rungs = Array.from({ length: 35 }, (_, i) => {
	const x = -170 + i * 10;
	const y = 22 * Math.sin((x / 80) * 2 * Math.PI);
	return { x, y1: y.toFixed(2), y2: (-y).toFixed(2) };
});

const ellipse = 'M-72,0 A72,26 0 1 0 72,0 A72,26 0 1 0 -72,0';
---

<div class:list={['lab-illustration relative overflow-hidden text-foreground', className]}>
	<svg
		viewBox="0 0 600 640"
		preserveAspectRatio="xMidYMid meet"
		class="absolute inset-0 h-full w-full"
		role="img"
		aria-label="Animated line drawing of laboratory objects: test tubes, an atom, a flask, a thermometer, a microscope, safety goggles and a DNA helix"
		fill="none"
		stroke="currentColor"
		stroke-width="3"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<defs>
			{tubes.map((t) => (
				<clipPath id={`clip-${t.id}`}><path d={tubeInner(t.h)} /></clipPath>
			))}
			<clipPath id="clip-flask"><path d="M-15,-78 L-15,-18 L-56,58 Q-61,69 -49,69 L49,69 Q61,69 56,58 L15,-18 L15,-78 Z" /></clipPath>
			<clipPath id="clip-goggles">
				<path d="M-96,-26 Q-96,-40 -78,-40 H78 Q96,-40 96,-26 V8 Q96,30 72,30 H40 Q24,30 16,14 Q0,-2 -16,14 Q-24,30 -40,30 H-72 Q-96,30 -96,8 Z" />
			</clipPath>
			<linearGradient id="dna-fade" x1="0" x2="1" y1="0" y2="0">
				<stop offset="0" stop-color="#fff" stop-opacity="0" />
				<stop offset="0.2" stop-color="#fff" stop-opacity="1" />
				<stop offset="0.8" stop-color="#fff" stop-opacity="1" />
				<stop offset="1" stop-color="#fff" stop-opacity="0" />
			</linearGradient>
			<mask id="dna-mask" maskUnits="userSpaceOnUse" x="-90" y="-40" width="180" height="80">
				<rect x="-90" y="-40" width="180" height="80" fill="url(#dna-fade)" stroke="none" />
			</mask>
		</defs>

		<!-- floating bubbles -->
		<g fill="var(--color-mint-400)" stroke="none">
			<circle class="float" style="--d:0s" cx="38" cy="44" r="13" />
			<circle class="float" style="--d:-1.2s" cx="78" cy="64" r="19" />
			<circle class="float" style="--d:-2.4s" cx="104" cy="104" r="9" />
			<circle class="float" style="--d:-0.6s" cx="34" cy="124" r="6" />
			<circle class="float" style="--d:-1.8s" cx="222" cy="372" r="20" />
			<circle class="float" style="--d:-3s" cx="204" cy="408" r="11" />
			<circle class="float" style="--d:-0.9s" cx="244" cy="420" r="6" />
		</g>

		<!-- test tubes -->
		{tubes.map((t) => (
			<g transform={`translate(${t.x} ${t.y}) rotate(${t.rot})`}>
				<g class="sway" style={`--d:${t.delay}s`}>
					<path d={tubeBody(t.h)} fill="var(--background)" />
					<g clip-path={`url(#clip-${t.id})`} stroke="none">
						<g class="level" style={`--d:${t.delay}s`}>
							<path class="wave" d={wave(t.level, t.h + 10)} fill="var(--color-mint-400)" />
						</g>
						{[0, 1, 2].map((i) => (
							<circle class="rise" style={`--d:${t.delay - i * 0.9}s; --rise:${-(t.h - t.level - 22)}px`} cx={-6 + i * 6} cy={t.h - 16} r={2.6 - i * 0.4} fill="var(--background)" />
						))}
					</g>
					<path d={tubeBody(t.h)} />
					<path d="M-25,0 H25" stroke-width="3.5" />
					{[0, 1, 2, 3].map((i) => (
						<path d={`M4,${30 + i * 18} H15`} stroke-width="2.5" />
					))}
				</g>
			</g>
		))}

		<!-- atom -->
		<g transform="translate(330 98)">
			<g class="spin">
				{[0, 60, 120].map((r, i) => (
					<g transform={`rotate(${r})`}>
						<path d={ellipse} />
						<circle r="5" fill="var(--color-coral-400)" stroke="none">
							<animateMotion dur={`${3 + i * 0.7}s`} repeatCount="indefinite" path={ellipse} />
						</circle>
					</g>
				))}
			</g>
			<circle class="pulse" r="10" fill="var(--background)" />
		</g>

		<!-- erlenmeyer flask -->
		<g transform="translate(505 118) rotate(16)">
			<g class="swirl">
				<path d="M-18,-80 L-18,-20 L-60,60 Q-66,72 -52,72 L52,72 Q66,72 60,60 L18,-20 L18,-80" fill="var(--background)" />
				<g clip-path="url(#clip-flask)" stroke="none">
					<path class="wave slow" d={wave(22, 90, -120, 120)} fill="var(--color-mint-400)" />
					<circle class="rise" style="--d:0s; --rise:-80px" cx="-6" cy="60" r="3" fill="var(--background)" />
					<circle class="rise" style="--d:-1.1s; --rise:-80px" cx="8" cy="64" r="2.4" fill="var(--background)" />
				</g>
				<path d="M-18,-80 L-18,-20 L-60,60 Q-66,72 -52,72 L52,72 Q66,72 60,60 L18,-20 L18,-80" />
				<path d="M-26,-80 H26" stroke-width="3.5" />
				{[0, 1, 2].map((i) => (
					<path d={`M${-4 - i * 8},${4 + i * 18} H${8 - i * 8}`} stroke-width="2.5" />
				))}
			</g>
			<g fill="var(--color-mint-400)" stroke="none">
				<circle class="vapour" style="--d:0s" cx="0" cy="-92" r="6" />
				<circle class="vapour" style="--d:-1.4s" cx="-6" cy="-92" r="4" />
				<circle class="vapour" style="--d:-2.8s" cx="5" cy="-92" r="5" />
			</g>
		</g>

		<!-- thermometer -->
		<g transform="translate(300 214) rotate(18)">
			<rect x="0" y="-13" width="200" height="26" rx="13" fill="var(--background)" />
			<line class="mercury" x1="14" y1="0" x2="58" y2="0" stroke="var(--color-coral-400)" stroke-width="8" />
			<rect x="72" y="-7" width="52" height="14" rx="3" />
			<line class="blink" x1="82" y1="0" x2="112" y2="0" stroke-width="2.5" />
			<rect x="200" y="-6" width="24" height="12" rx="4" fill="var(--background)" />
		</g>

		<!-- microscope -->
		<g transform="translate(150 456) scale(0.9)">
			<path d="M-50,150 C-130,110 -122,-22 -10,-42 L0,-14 C-82,0 -92,100 -22,140 Z" fill="var(--color-mint-400)" />
			<rect x="-96" y="150" width="160" height="34" rx="10" fill="var(--background)" />
			<path class="beam" d="M16,58 L-6,90 H38 Z" fill="var(--color-mint-300)" stroke="none" />
			<rect x="-44" y="88" width="116" height="12" rx="3" fill="var(--background)" />
			<circle cx="-48" cy="120" r="9" fill="var(--background)" />
			<g class="focus">
				<rect x="2" y="-164" width="28" height="44" rx="4" fill="var(--background)" />
				<path d="M2,-150 H30" stroke-width="2.5" />
				<rect x="-6" y="-120" width="44" height="120" rx="6" fill="var(--background)" />
				<path d="M8,-96 V-30" stroke-width="2.5" />
				<rect x="4" y="0" width="24" height="40" rx="3" fill="var(--background)" />
				<rect x="10" y="40" width="12" height="16" rx="2" fill="var(--background)" />
			</g>
			<g transform="translate(-14 -34)">
				<g class="knob">
					<circle r="15" fill="var(--background)" />
					<path d="M-8,0 H8 M0,-8 V8" stroke-width="2.5" />
				</g>
			</g>
		</g>

		<!-- safety goggles -->
		<g transform="translate(430 496) rotate(14) scale(0.9)">
			<g class="bob">
				<path d="M-110,-12 L-138,0 M110,-12 L138,0" stroke-width="5" />
				<path d="M-110,-30 Q-110,-52 -84,-52 H84 Q110,-52 110,-30 V10 Q110,42 78,42 H44 Q24,42 14,22 Q0,6 -14,22 Q-24,42 -44,42 H-78 Q-110,42 -110,10 Z" fill="var(--background)" />
				<g clip-path="url(#clip-goggles)">
					<path class="shine" d="M-30,-60 L-70,60 M-12,-60 L-52,60" stroke="var(--color-mint-400)" stroke-width="8" />
				</g>
				<path d="M-96,-26 Q-96,-40 -78,-40 H78 Q96,-40 96,-26 V8 Q96,30 72,30 H40 Q24,30 16,14 Q0,-2 -16,14 Q-24,30 -40,30 H-72 Q-96,30 -96,8 Z" stroke-width="2.5" />
			</g>
		</g>

		<!-- DNA helix -->
		<g transform="translate(392 604) rotate(-8)">
			<g mask="url(#dna-mask)">
				<g class="helix">
					{rungs.map((r) => (
						<line x1={r.x} y1={r.y1} x2={r.x} y2={r.y2} stroke-width="2" />
					))}
					<path d={helix(0)} stroke-width="5" />
					<path d={helix(Math.PI)} stroke-width="5" />
				</g>
			</g>
		</g>
	</svg>
</div>

<style>
	.float, .sway, .spin, .pulse, .swirl, .vapour, .mercury, .knob, .bob {
		transform-box: fill-box;
	}

	.float { animation: float 6s ease-in-out var(--d, 0s) infinite; transform-origin: center; }
	@keyframes float {
		0%, 100% { transform: translateY(0) scale(1); }
		50% { transform: translateY(-10px) scale(1.06); }
	}

	.sway { animation: sway 7s ease-in-out var(--d, 0s) infinite; transform-origin: 50% 0; }
	@keyframes sway {
		0%, 100% { transform: rotate(-2deg); }
		50% { transform: rotate(2deg); }
	}

	.level { animation: level 5s ease-in-out var(--d, 0s) infinite; }
	@keyframes level {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-8px); }
	}

	.wave { animation: wave 2.4s linear infinite; }
	.wave.slow { animation-duration: 4s; }
	@keyframes wave {
		from { transform: translateX(0); }
		to { transform: translateX(40px); }
	}

	.rise { animation: rise 2.7s ease-in var(--d, 0s) infinite; }
	@keyframes rise {
		0% { transform: translateY(0); opacity: 0; }
		15% { opacity: 1; }
		85% { opacity: 1; }
		100% { transform: translateY(var(--rise, -60px)); opacity: 0; }
	}

	.spin { animation: spin 40s linear infinite; transform-origin: center; }
	@keyframes spin { to { transform: rotate(360deg); } }

	.pulse { animation: pulse 2.4s ease-in-out infinite; transform-origin: center; }
	@keyframes pulse {
		0%, 100% { transform: scale(1); }
		50% { transform: scale(1.25); }
	}

	.swirl { animation: swirl 6s ease-in-out infinite; transform-origin: 50% 100%; }
	@keyframes swirl {
		0%, 100% { transform: rotate(-3deg); }
		50% { transform: rotate(3deg); }
	}

	.vapour { animation: vapour 4.2s ease-out var(--d, 0s) infinite; transform-origin: center; }
	@keyframes vapour {
		0% { transform: translate(0, 0) scale(0.4); opacity: 0; }
		20% { opacity: 1; }
		100% { transform: translate(14px, -70px) scale(1.4); opacity: 0; }
	}

	.mercury { animation: mercury 6s ease-in-out infinite; transform-origin: 0 50%; }
	@keyframes mercury {
		0%, 100% { transform: scaleX(0.45); }
		50% { transform: scaleX(1); }
	}

	.blink { animation: blink 1.2s steps(2, jump-none) infinite; }
	@keyframes blink { 50% { opacity: 0.15; } }

	.focus { animation: focus 5s ease-in-out infinite; }
	@keyframes focus {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-8px); }
	}

	.knob { animation: knob 5s ease-in-out infinite; transform-origin: center; }
	@keyframes knob {
		0%, 100% { transform: rotate(0deg); }
		50% { transform: rotate(-180deg); }
	}

	.beam { animation: beam 5s ease-in-out infinite; }
	@keyframes beam {
		0%, 100% { opacity: 0.9; }
		50% { opacity: 0.25; }
	}

	.bob { animation: bob 6s ease-in-out infinite; transform-origin: center; }
	@keyframes bob {
		0%, 100% { transform: translateY(0) rotate(0deg); }
		50% { transform: translateY(-8px) rotate(-3deg); }
	}

	.shine { animation: shine 4.5s ease-in-out infinite; }
	@keyframes shine {
		0%, 55% { transform: translateX(-80px); }
		100% { transform: translateX(240px); }
	}

	.helix { animation: helix 4s linear infinite; }
	@keyframes helix {
		from { transform: translateX(0); }
		to { transform: translateX(80px); }
	}

	@media (prefers-reduced-motion: reduce) {
		.lab-illustration :global(svg *) { animation: none !important; }
	}
</style>

<script>
	// Freeze the SMIL parts (electrons, blobs) for visitors who prefer reduced motion,
	// and pause everything while the illustration is off-screen.
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	document.querySelectorAll<HTMLElement>('.lab-illustration').forEach((root) => {
		const svg = root.querySelector('svg');
		if (!svg) return;
		if (reduce) {
			svg.pauseAnimations();
			return;
		}
		new IntersectionObserver(([entry]) => {
			const on = entry.isIntersecting;
			root.classList.toggle('is-paused', !on);
			if (on) svg.unpauseAnimations();
			else svg.pauseAnimations();
		}).observe(root);
	});
</script>

<style is:global>
	.lab-illustration.is-paused svg * { animation-play-state: paused !important; }
</style>
