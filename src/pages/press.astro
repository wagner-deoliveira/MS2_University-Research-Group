---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { pressData } from '@/data/press';
---

<Layout title="Press and Media - Magnetic Soft Matter Group">
  <Header />
  <main>
    <section class="relative h-[40vh] bg-black overflow-hidden">
      <img src="/assets/images/publications/publications_jtron.jpg" alt="Background" class="absolute inset-0 w-full h-full object-cover opacity-50 blur-sm" />
      <div class="relative z-10 container mx-auto px-4 h-full flex flex-col justify-center text-white">
        <h1 class="text-5xl font-bold mb-4">Press and Media</h1>
        <p class="text-xl opacity-90">News and media coverage of our research</p>
      </div>
    </section>

    <!-- News List -->
    <section class="py-16 container mx-auto px-4">
      <div class="max-w-4xl mx-auto space-y-12">
        {pressData.map(group => (
          <div>
            <h2 class="text-3xl font-bold mb-6 text-foreground border-b-2 border-border pb-2">{group.year}</h2>
            <ul class="space-y-6">
              {group.items.map(item => (
                <li class="p-6 bg-card rounded-lg shadow-sm border space-y-4">
                  <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                    {item.date && (
                      <span class="font-bold text-sm bg-muted px-2.5 py-1 rounded w-fit">
                        {item.date}
                      </span>
                    )}
                    <h3 class="text-lg font-bold text-foreground">
                      {item.title}
                    </h3>
                  </div>

                  {item.es && (
                    <p class="text-muted-foreground text-sm leading-relaxed">
                      <span class="font-semibold text-foreground">🇪🇸 ES:</span> {item.es}
                    </p>
                  )}

                  {item.en && (
                    <p class="text-muted-foreground text-sm leading-relaxed">
                      <span class="font-semibold text-foreground">🌐 EN:</span> {item.en}
                    </p>
                  )}

                  {item.links.length > 0 && (
                    <div class="flex flex-wrap gap-3 pt-2">
                      {item.links.map(link => (
                        <a
                          href={link.href}
                          target="_blank"
                          class="inline-flex items-center text-xs font-medium bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 hover:bg-blue-100 dark:hover:bg-blue-900/50 px-3 py-1.5 rounded transition-colors"
                        >
                          {link.text} ✶
                        </a>
                      ))}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
