---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { pressData } from '@/data/press';
import PageHero from '@/components/PageHero.astro';
---

<Layout title="Press and Media - Magnetic Soft Matter Group">
  <Header />
  <main class="bg-background text-foreground">
    <PageHero
      eyebrow="Newsroom"
      title="Press and"
      highlight="Media"
      subtitle="News and media coverage of our research."
      image="/assets/images/publications/publications_jtron.jpg"
    />

    <section class="container mx-auto px-4 py-24">
      <div class="mx-auto max-w-4xl space-y-20">
        {pressData.map(group => (
          <div>
            <div class="flex items-center gap-4">
              <h2 class="bg-gradient-to-r from-indigo-600 to-cyan-500 bg-clip-text text-4xl font-bold tracking-tight text-transparent">{group.year}</h2>
              <div class="h-px flex-1 bg-border"></div>
            </div>
            <ol class="relative mt-8 space-y-6 border-l border-indigo-200 pl-8 dark:border-indigo-900">
              {group.items.map(item => (
                <li class="relative space-y-4 rounded-2xl border bg-card p-6 shadow-sm transition hover:shadow-lg">
                  <span class="absolute -left-[2.55rem] top-7 h-3.5 w-3.5 rounded-full bg-gradient-to-br from-indigo-500 to-cyan-400 ring-4 ring-background"></span>
                  {item.date && (
                    <span class="inline-block rounded-full bg-muted px-3 py-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{item.date}</span>
                  )}
                  <h3 class="text-lg font-semibold leading-snug">{item.title}</h3>
                  {item.es && (
                    <p class="text-sm leading-relaxed text-muted-foreground"><span class="font-semibold text-foreground">🇪🇸 ES:</span> {item.es}</p>
                  )}
                  {item.en && (
                    <p class="text-sm leading-relaxed text-muted-foreground"><span class="font-semibold text-foreground">🌐 EN:</span> {item.en}</p>
                  )}
                  {item.links.length > 0 && (
                    <div class="flex flex-wrap gap-2 pt-2">
                      {item.links.map(link => (
                        <a href={link.href} target="_blank" rel="noopener" class="rounded-full border px-3 py-1 text-xs font-semibold text-indigo-600 transition hover:border-indigo-400 hover:bg-indigo-50 dark:text-indigo-300 dark:hover:bg-indigo-950">{link.text} →</a>
                      ))}
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
