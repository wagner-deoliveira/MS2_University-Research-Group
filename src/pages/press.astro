---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { pressData } from '@/data/press';
import PageHero from '@/components/PageHero.astro';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const formatDate = (date?: string, year?: string) => {
	if (!date) return year ?? '';
	const [y, m, d] = date.split('-');
	return `${Number(d)} ${MONTHS[Number(m) - 1]} ${y}`;
};

const OUTLETS: Record<string, string> = {
	'canal.ugr.es': 'Canal UGR',
	'ideal.es': 'Ideal',
	'canalsur.es': 'Canal Sur',
	'linkedin.com': 'LinkedIn',
};

const outletOf = (href?: string) => {
	if (!href) return 'UGR';
	try {
		const host = new URL(href).hostname.replace(/^www\./, '');
		return OUTLETS[host] ?? host;
	} catch {
		return 'UGR';
	}
};

const wire = pressData.flatMap((group) =>
	group.items.map((item) => ({
		title: item.title,
		date: formatDate(item.date, group.year),
		outlet: outletOf(item.links[0]?.href),
		href: item.links[0]?.href,
	}))
);

const years = pressData.map((g) => g.year);
const outlets = new Set(wire.filter((w) => w.outlet !== 'UGR').map((w) => w.outlet));
---

<Layout title="Press and Media - Magnetic Soft Matter Group">
  <Header />
  <main class="bg-background text-foreground">
    <PageHero
      eyebrow="Newsroom"
      title="Press and"
      highlight="Media"
      subtitle="News and media coverage of our research."
      press={wire}
      stats={[
        { value: String(wire.length), label: 'Headlines' },
        { value: `${years[years.length - 1]}–${years[0]}`, label: 'Coverage' },
        { value: String(outlets.size), label: 'Outlets' },
      ]}
    />

    <section class="container mx-auto px-4 py-24">
      <div class="mx-auto max-w-4xl space-y-20">
        {pressData.map(group => (
          <div>
            <div class="flex items-center gap-4">
              <h2 class="bg-gradient-to-r from-brand-600 to-mint-500 bg-clip-text text-4xl font-bold tracking-tight text-transparent">{group.year}</h2>
              <div class="h-px flex-1 bg-border"></div>
            </div>
            <ol class="relative mt-8 space-y-6 border-l border-brand-200 pl-8 dark:border-brand-900">
              {group.items.map(item => (
                <li class="relative space-y-4 rounded-2xl border bg-card p-6 shadow-sm transition hover:shadow-lg">
                  <span class="absolute -left-[2.55rem] top-7 h-3.5 w-3.5 rounded-full bg-gradient-to-br from-brand-500 to-mint-400 ring-4 ring-background"></span>
                  {item.date && (
                    <span class="inline-block rounded-full bg-muted px-3 py-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{item.date}</span>
                  )}
                  <h3 class="text-lg font-semibold leading-snug">{item.title}</h3>
                  {item.es && (
                    <p class="text-sm leading-relaxed text-muted-foreground"><span class="font-semibold text-foreground">🇪🇸 ES:</span> {item.es}</p>
                  )}
                  {item.en && (
                    <p class="text-sm leading-relaxed text-muted-foreground"><span class="font-semibold text-foreground">🌐 EN:</span> {item.en}</p>
                  )}
                  {item.links.length > 0 && (
                    <div class="flex flex-wrap gap-2 pt-2">
                      {item.links.map(link => (
                        <a href={link.href} target="_blank" rel="noopener" class="rounded-full border px-3 py-1 text-xs font-semibold text-brand-600 transition hover:border-brand-400 hover:bg-brand-50 dark:text-brand-300 dark:hover:bg-brand-950">{link.text} →</a>
                      ))}
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
