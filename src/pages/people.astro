---

<Layout title="Our Team - Magnetic Soft Matter Group">
  <Header />
  <main class="bg-background text-foreground">
    <PageHero
      eyebrow="People"
      title="Our"
      highlight="Team"
      subtitle="One by one, all of the components of our driving force."
      team={[
        { name: leader.name, image: leader.image, ring: 0 },
        ...permanentStaff.map((m) => ({ name: m.name, image: m.image, imagePosition: m.imagePosition, ring: 1 as const })),
        ...researchStaff.map((m) => ({ name: m.name, image: m.image, imagePosition: m.imagePosition, ring: 2 as const })),
        ...team.filter((m) => m.initials).map((m) => ({ name: m.name, initials: m.initials, ring: 3 as const })),
      ]}
      stats={[
        { value: String(1 + permanentStaff.length), label: 'Faculty' },
        { value: String(researchStaff.length), label: 'Researchers & PhDs' },
        { value: String(students.length), label: 'Students' },
        { value: String(formerMembers.reduce((n, g) => n + g.items.length, 0)), label: 'Alumni & visitors' },
      ]}
    />

    <!-- Team -->
    <section class="bg-mint-50 py-24 dark:bg-ink-950/40 md:py-32">
      <div class="container mx-auto px-4">
        <h2 class="text-5xl font-medium tracking-tight md:text-7xl">Team</h2>
        <div class="mt-6 flex items-center" aria-hidden="true">
          <span class="h-3 w-3 shrink-0 rounded-full bg-mint-400"></span>
          <span class="h-px flex-1 bg-ink-200 dark:bg-white/15"></span>
        </div>

        <ul class="team-grid mt-20 grid grid-cols-2 gap-x-6 gap-y-16 sm:grid-cols-3 md:mt-28 md:gap-y-24 lg:grid-cols-4">
          {team.map((m) => (
            <li class="min-w-0 text-center">
              {m.description ? (
                <div class="member group relative">
                  <button type="button" class="member-toggle relative z-30 w-full cursor-pointer rounded-3xl text-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-600" aria-expanded="false">
                    <span class="relative mx-auto block w-fit">
                      <Image src={m.image!} alt="" width={320} height={Math.round((m.image!.height / m.image!.width) * 320)} widths={[160, 320]} sizes="160px" loading="lazy" decoding="async" class="h-32 w-32 rounded-full bg-ink-100 object-cover shadow-sm transition duration-500 group-hover:scale-[1.03] sm:h-40 sm:w-40" style={`object-position: center ${m.imagePosition ?? 'top'}`} />
                      <span class="member-badge absolute bottom-1 right-1 flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-white shadow-sm transition duration-300 group-hover:scale-110" aria-hidden="true">
                        <svg viewBox="0 0 24 24" class="member-plus h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                        <svg viewBox="0 0 24 24" class="member-close absolute h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                      </span>
                    </span>
                    <span class="mt-8 block text-lg font-medium leading-tight md:text-xl">{m.name}</span>
                    <span class="mt-1.5 block text-sm text-muted-foreground">{m.label}</span>
                  </button>
                  <div class="member-card pointer-events-none absolute left-1/2 top-0 z-20 w-[calc(100%+1.5rem)] max-w-xs -translate-x-1/2">
                    <div class="member-panel overflow-hidden rounded-3xl border border-ink-950/10 bg-white text-left shadow-xl dark:border-white/10 dark:bg-ink-900">
                      <div class="member-spacer" aria-hidden="true"></div>
                      <div class="member-body px-5 pb-6 text-ink-700 dark:text-white/75">
                        <p class="text-sm leading-relaxed">{m.description}</p>
                        {m.email && <a href={`mailto:${m.email}`} class="mt-4 block break-all text-xs text-brand-700 underline-offset-2 hover:underline dark:text-mint-400">{m.email}</a>}
                        {m.website && <a href={m.website} target="_blank" rel="noopener" class="mt-1 inline-block text-xs font-semibold text-brand-700 hover:underline dark:text-mint-400">Website →</a>}
                      </div>
                    </div>
                  </div>
                </div>
              ) : (
                <>
                  <span class="mx-auto flex h-32 w-32 items-center justify-center rounded-full bg-gradient-to-br from-mint-200 to-mint-400 font-display text-4xl font-medium text-ink-950 sm:h-40 sm:w-40">{m.initials}</span>
                  <h3 class="mt-8 text-lg font-medium leading-tight md:text-xl">{m.name}</h3>
                  <p class="mt-1.5 text-sm text-muted-foreground">{m.label}</p>
                </>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Former members -->
    <section class="container mx-auto px-4 py-24">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-600 dark:text-brand-400">Alumni</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-5xl">Former team members</h2>
      </div>
      <div class="mx-auto mt-12 max-w-4xl space-y-4">
        {formerMembers.map((group, i) => (
          <details class="group rounded-2xl border bg-card shadow-sm open:shadow-md" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between p-6">
              <span class="text-lg font-semibold">{group.category}</span>
              <span class="flex items-center gap-3 text-sm text-muted-foreground">
                {group.items.length}
                <span class="transition group-open:rotate-45 text-xl leading-none">+</span>
              </span>
            </summary>
            <ul class="divide-y divide-border border-t px-6">
              {group.items.map(item => <li class="py-3 text-sm text-muted-foreground">{item}</li>)}
            </ul>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .member-card {
    visibility: hidden;
  }
  .member-panel {
    max-height: 0;
    opacity: 0;
    transition: max-height 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
  }
  .member.is-open {
    z-index: 100;
  }
  .member.is-open .member-card {
    visibility: visible;
    pointer-events: auto;
  }
  .member.is-open .member-panel {
    max-height: 46rem;
    opacity: 1;
  }
  .member-body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease, padding 0.45s ease;
  }
  .member-body > * {
    overflow: hidden;
  }
  .member.is-open .member-body {
    grid-template-rows: 1fr;
    opacity: 1;
    transition-delay: 0.08s;
  }
  .member-close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .member-plus {
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .member.is-open .member-plus {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  .member.is-open .member-close {
    opacity: 1;
    transform: none;
  }
  .member.is-open .member-badge {
    background-color: var(--color-ink-950);
  }
</style>

<script>
  const members = document.querySelectorAll<HTMLElement>('.member');
  const closeAll = (except?: HTMLElement) => {
    members.forEach((member) => {
      if (member === except) return;
      member.classList.remove('is-open');
      member.querySelector('.member-toggle')?.setAttribute('aria-expanded', 'false');
    });
  };

  const place = (member: HTMLElement) => {
    const toggle = member.querySelector<HTMLElement>('.member-toggle');
    const spacer = member.querySelector<HTMLElement>('.member-spacer');
    if (toggle && spacer) spacer.style.height = `${toggle.offsetHeight + 28}px`;
  };

  members.forEach((member) => {
    place(member);
    const toggle = member.querySelector<HTMLButtonElement>('.member-toggle');
    toggle?.addEventListener('click', () => {
      const open = member.classList.contains('is-open');
      closeAll(open ? undefined : member);
      member.classList.toggle('is-open', !open);
      toggle.setAttribute('aria-expanded', String(!open));
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAll();
  });
  window.addEventListener('resize', () => members.forEach(place));
</script>
