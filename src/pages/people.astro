---

<Layout title="Our Team - Magnetic Soft Matter Group">
  <Header />
  <main>
    <section class="relative h-[40vh] bg-black overflow-hidden">
      <img src="/assets/images/people/people_jtron.jpg" alt="Background" class="absolute inset-0 w-full h-full object-cover opacity-50 blur-sm" />
      <div class="relative z-10 container mx-auto px-4 h-full flex flex-col justify-center text-white">
        <h1 class="text-5xl font-bold mb-4">Our Team</h1>
        <p class="text-xl opacity-90">One by one, all of the components of our driving force</p>
      </div>
    </section>

    <section class="py-16 container mx-auto px-4">
      <!-- Group Leader -->
      <div class="mb-20">
        <h2 class="text-3xl font-bold mb-8 text-center border-b pb-4">Group leader</h2>
        <div class="max-w-md mx-auto bg-card rounded-xl shadow-lg overflow-hidden border">
          <img src={leader.image} alt={leader.name} class="w-full h-80 object-contain bg-muted" />
          <div class="p-6">
            <h3 class="text-xl font-bold mb-1">{leader.name}</h3>
            <p class="text-blue-600 dark:text-blue-400 font-medium mb-3">{leader.role}</p>
            <p class="text-muted-foreground text-sm mb-4">{leader.description}</p>
            <div class="flex items-center justify-between text-xs text-muted-foreground/80">
              <a href={`mailto:${leader.email}`} class="hover:underline">{leader.email}</a>
              {leader.website && (
                <a href={leader.website} target="_blank" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">Personal Website ✶</a>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- Permanent Staff -->
      <div class="mb-20">
        <h2 class="text-3xl font-bold mb-8 text-center border-b pb-4">Permanent Staff</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
          {permanentStaff.map(member => (
            <div class="bg-card rounded-xl shadow-lg overflow-hidden border flex flex-col justify-between">
              <div>
                <img src={member.image} alt={member.name} class="w-full h-64 object-contain bg-muted" />
                <div class="p-6">
                  <h3 class="text-xl font-bold mb-1">{member.name}</h3>
                  <p class="text-blue-600 dark:text-blue-400 font-medium mb-3">{member.role}</p>
                  <p class="text-muted-foreground text-sm mb-4">{member.description}</p>
                </div>
              </div>
              <div class="px-6 pb-6 pt-0">
                <a href={`mailto:${member.email}`} class="text-xs text-muted-foreground/80 hover:underline">{member.email}</a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Research Staff -->
      <div class="mb-20">
        <h2 class="text-3xl font-bold mb-8 text-center border-b pb-4">Research Staff</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {researchStaff.map(member => (
            <div class="bg-card rounded-xl shadow-lg overflow-hidden border flex flex-col justify-between">
              <div>
                <img src={member.image} alt={member.name} class="w-full h-64 object-contain bg-muted" />
                <div class="p-6">
                  <h3 class="text-xl font-bold mb-1">{member.name}</h3>
                  <p class="text-blue-600 dark:text-blue-400 font-medium mb-3">{member.role}</p>
                  <p class="text-muted-foreground text-sm mb-4">{member.description}</p>
                </div>
              </div>
              <div class="px-6 pb-6 pt-0 flex items-center justify-between text-xs text-muted-foreground/80">
                <a href={`mailto:${member.email}`} class="hover:underline">{member.email}</a>
                {member.website && (
                  <a href={member.website} target="_blank" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">Personal Website ✶</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Students -->
      <div class="mb-20">
        <h2 class="text-3xl font-bold mb-8 text-center border-b pb-4">Students</h2>
        <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-4">
          {students.map(student => (
            <div class="p-4 bg-muted rounded-lg text-center font-medium text-foreground border">
              {student}
            </div>
          ))}
        </div>
      </div>

      <!-- Former Team Members -->
      <div>
        <h2 class="text-3xl font-bold mb-8 text-center border-b pb-4">Former Team members</h2>
        <div class="max-w-4xl mx-auto space-y-10">
          {formerMembers.map(group => (
            <div class="bg-card rounded-xl p-6 border shadow-sm">
              <h3 class="text-xl font-bold mb-4 text-blue-600 dark:text-blue-400">{group.category}</h3>
              <ul class="divide-y divide-border">
                {group.items.map(item => (
                  <li class="py-3 text-sm text-muted-foreground">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
