---

<Layout title="Our Team - Magnetic Soft Matter Group">
  <Header />
  <main class="bg-background text-foreground">
    <PageHero
      eyebrow="People"
      title="Our"
      highlight="Team"
      subtitle="One by one, all of the components of our driving force."
      image="/assets/images/people/people_jtron.jpg"
      stats={[
        { value: String(1 + permanentStaff.length), label: 'Faculty' },
        { value: String(researchStaff.length), label: 'Researchers & PhDs' },
        { value: String(students.length), label: 'Students' },
        { value: String(formerMembers.reduce((n, g) => n + g.items.length, 0)), label: 'Alumni & visitors' },
      ]}
    />

    <!-- Leader -->
    <section class="container mx-auto px-4 py-24">
      <div class="mx-auto grid max-w-4xl items-center overflow-hidden rounded-3xl border bg-card shadow-lg md:grid-cols-5">
        <img src={leader.image} alt={leader.name} class="h-64 w-full bg-muted object-cover object-center md:col-span-2 md:h-full" />
        <div class="p-6 md:col-span-3 md:p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600 dark:text-indigo-400">Group leader</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">{leader.name}</h2>
          <p class="mt-1 font-medium text-muted-foreground">{leader.role}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {leader.description.split(', ').map(t => <span class="rounded-full border bg-muted px-3 py-1 text-sm">{t}</span>)}
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href={`mailto:${leader.email}`} class="rounded-full bg-slate-900 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-white dark:text-slate-900">{leader.email}</a>
            <a href={leader.website} target="_blank" rel="noopener" class="rounded-full border px-6 py-2.5 text-sm font-semibold transition hover:bg-muted">Personal website →</a>
          </div>
        </div>
      </div>
    </section>

    {[{ title: 'Permanent staff', eyebrow: 'Faculty', list: permanentStaff }, { title: 'Research staff', eyebrow: 'Postdocs & PhD candidates', list: researchStaff }].map((sec, i) => (
      <section class={i === 0 ? 'bg-muted/50 py-24' : 'py-24'}>
        <div class="container mx-auto px-4">
          <div class="mx-auto max-w-2xl text-center">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600 dark:text-indigo-400">{sec.eyebrow}</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-5xl">{sec.title}</h2>
          </div>
          <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {sec.list.map((m: any) => (
              <article class="group flex flex-col overflow-hidden rounded-2xl border bg-card shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
                <div class="overflow-hidden bg-muted">
                  <img src={m.image} alt={m.name} loading="lazy" class="h-72 w-full object-cover transition duration-500 group-hover:scale-105" style={`object-position: center ${m.imagePosition ?? 'top'}`} />
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">{m.role}</p>
                  <h3 class="mt-2 text-lg font-semibold">{m.name}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{m.description}</p>
                  <div class="mt-auto flex items-center justify-between gap-2 pt-6 text-xs">
                    <a href={`mailto:${m.email}`} class="truncate text-muted-foreground hover:text-foreground hover:underline">{m.email}</a>
                    {m.website && <a href={m.website} target="_blank" rel="noopener" class="shrink-0 font-semibold text-indigo-600 hover:underline dark:text-indigo-400">Website →</a>}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- Students -->
    <section class="bg-muted/50 py-24">
      <div class="container mx-auto px-4">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600 dark:text-indigo-400">Next generation</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-5xl">Students</h2>
        </div>
        <ul class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-2">
          {students.map(s => {
            const [name, role] = s.split('. ');
            return (
              <li class="flex items-center gap-4 rounded-2xl border bg-card p-5 shadow-sm">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-cyan-400 font-semibold text-white">{name.split(' ').map(w => w[0]).slice(0, 2).join('')}</span>
                <div><p class="font-semibold">{name}</p><p class="text-sm text-muted-foreground">{role}</p></div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <!-- Former members -->
    <section class="container mx-auto px-4 py-24">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600 dark:text-indigo-400">Alumni</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-5xl">Former team members</h2>
      </div>
      <div class="mx-auto mt-12 max-w-4xl space-y-4">
        {formerMembers.map((group, i) => (
          <details class="group rounded-2xl border bg-card shadow-sm open:shadow-md" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between p-6">
              <span class="text-lg font-semibold">{group.category}</span>
              <span class="flex items-center gap-3 text-sm text-muted-foreground">
                {group.items.length}
                <span class="transition group-open:rotate-45 text-xl leading-none">+</span>
              </span>
            </summary>
            <ul class="divide-y divide-border border-t px-6">
              {group.items.map(item => <li class="py-3 text-sm text-muted-foreground">{item}</li>)}
            </ul>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
