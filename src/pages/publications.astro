---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { publicationYears } from '@/data/publications';
import { Badge } from '@/components/ui/badge';

const stats = [
  { label: "Physics" },
  { label: "Chemistry" },
  { label: "Biology" }
];
---

<Layout title="Publications - Magnetic Soft Matter Group">
  <Header />
  <main>
    <section class="relative h-[40vh] bg-black overflow-hidden">
      <img src="/assets/images/publications/publications_jtron.jpg" alt="Background" class="absolute inset-0 w-full h-full object-cover opacity-50 blur-sm" />
      <div class="relative z-10 container mx-auto px-4 h-full flex flex-col justify-center text-white">
        <h1 class="text-5xl font-bold mb-4">Publications</h1>
        <p class="text-xl opacity-90">We publish regularly in a variety of journals in a number of fields</p>
      </div>
    </section>

    <!-- Publication Covers -->
    <section class="py-12 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          <a href="https://doi.org/10.1039/D0SM01082K" target="_blank" class="block rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow">
            <img src="/assets/images/publications/F2N2 (48).jpg" alt="Cover" class="w-full h-auto" />
          </a>
          <a href="https://doi.org/10.1122/1.5093628" target="_blank" class="block rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow">
            <img src="/assets/images/publications/F2N2 (81).jpg" alt="Cover" class="w-full h-auto" />
          </a>
          <a href="https://iopscience.iop.org/article/10.1088/0964-1726/23/12/125013" target="_blank" class="block rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow">
            <img src="/assets/images/publications/F2N2 (55).jpg" alt="Cover" class="w-full h-auto" />
          </a>
        </div>
      </div>
    </section>

    <!-- Publication List -->
    <section class="py-16 container mx-auto px-4">
      <div class="max-w-4xl mx-auto space-y-12">
        {publicationYears.map(group => (
          <div>
            <h2 class="text-3xl font-bold mb-6 text-slate-800 border-b-2 border-slate-100 pb-2">{group.year}</h2>
            <ul class="space-y-4">
              {group.items.map(item => (
                <li class="p-4 bg-white rounded-lg shadow-sm border flex items-start justify-between gap-4">
                  <p class="text-gray-700 leading-relaxed text-sm">{item.text}</p>
                  <a href={item.link} target="_blank" class="shrink-0 text-blue-600 font-medium hover:underline text-xs bg-blue-50 px-3 py-1 rounded">
                    link ✶
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Stats -->
    <section class="py-16 bg-slate-900 text-white">
      <div class="container mx-auto px-4 max-w-2xl text-center">
        <h2 class="text-3xl font-bold mb-10">Main macro areas of publication</h2>
        <div class="flex flex-wrap justify-center gap-4">
          {stats.map(stat => (
            <Badge variant="secondary" className="text-lg py-2 px-6">
              {stat.label}
            </Badge>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
