---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { publicationYears } from '@/data/publications';
import { Badge } from '@/components/ui/badge';

const covers = [
  {
    link: "https://doi.org/10.1021/acsnano.5c09450",
    image: "/assets/images/publications/acsnano_cover.jpg",
    alt: "ACS Nano Cover"
  },
  {
    link: "https://doi.org/10.1122/8.0000646",
    image: "/assets/images/publications/jor_cover_terkel.jpeg",
    alt: "Journal of Rheology Cover"
  },
  {
    link: "https://doi.org/10.1039/D0SM01082K",
    image: "/assets/images/publications/back_cover_morillas.jpg",
    alt: "Soft Matter Cover"
  },
  {
    link: "https://doi.org/10.1122/1.5093628",
    image: "/assets/images/publications/jor_cover_morillas.jpeg",
    alt: "Journal of Rheology Cover"
  },
  {
    link: "https://doi.org/10.1039/9781839169755",
    image: "/assets/images/publications/book_cover_devicente.png",
    alt: "Book Cover"
  }
];

const stats = [
  { label: "Physics" },
  { label: "Chemistry" },
  { label: "Biology" }
];
---

<Layout title="Publications - Magnetic Soft Matter Group">
  <Header />
  <main>
    <section class="relative h-[40vh] bg-black overflow-hidden">
      <img src="/assets/images/publications/publications_jtron.jpg" alt="Background" class="absolute inset-0 w-full h-full object-cover opacity-50 blur-sm" />
      <div class="relative z-10 container mx-auto px-4 h-full flex flex-col justify-center text-white">
        <h1 class="text-5xl font-bold mb-4">Publications</h1>
        <p class="text-xl opacity-90">We publish regularly in a variety of journals in a number of fields</p>
      </div>
    </section>

    <!-- Publication Covers -->
    <section class="py-12 bg-muted">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 max-w-6xl mx-auto">
          {covers.map(cover => (
            <a href={cover.link} target="_blank" class="block rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow bg-background p-2">
              <img src={cover.image} alt={cover.alt} class="w-full h-auto object-contain rounded" />
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Publication List -->
    <section class="py-16 container mx-auto px-4">
      <div class="max-w-4xl mx-auto space-y-12">
        {publicationYears.map(group => (
          <div>
            <h2 class="text-3xl font-bold mb-6 text-foreground border-b-2 border-border pb-2">{group.year}</h2>
            <ul class="space-y-4">
              {group.items.map(item => (
                <li class="p-4 bg-card rounded-lg shadow-sm border flex items-start justify-between gap-4">
                  <p class="text-muted-foreground leading-relaxed text-sm">{item.text}</p>
                  {item.link && (
                    <a href={item.link} target="_blank" class="shrink-0 text-blue-600 dark:text-blue-400 font-medium hover:underline text-xs bg-blue-50 dark:bg-blue-900/30 px-3 py-1 rounded">
                      link ✶
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Stats -->
    <section class="py-16 bg-slate-900 text-white">
      <div class="container mx-auto px-4 max-w-2xl text-center">
        <h2 class="text-3xl font-bold mb-10">Main macro areas of publication</h2>
        <div class="flex flex-wrap justify-center gap-4">
          {stats.map(stat => (
            <Badge variant="secondary" className="text-lg py-2 px-6">
              {stat.label}
            </Badge>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
